<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reservation Confirmed | ZAiKA</title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif}
    body{
      background:#0a0a0a;
      color:#fff;
      min-height:100vh;
      display:grid;
      place-items:center;
      padding:20px;
    }
    .card{
      max-width:480px;
      width:100%;
      background:linear-gradient(145deg,#1e1e1e,#161616);
      border:1px solid #2a2a2a;
      padding:50px 35px;
      border-radius:24px;
      text-align:center;
      animation: pop 0.5s ease;
    }
    @keyframes pop {
      0% { transform:scale(0.9); opacity:0; }
      100% { transform:scale(1); opacity:1; }
    }
    .check{
      width:80px;
      height:80px;
      background:linear-gradient(135deg,#22c55e,#16a34a);
      border-radius:50%;
      display:grid;
      place-items:center;
      margin:0 auto 20px auto;
      font-size:40px;
      box-shadow:0 0 30px rgba(34,197,94,0.4);
    }
    .card h1{
      font-size:28px;
      font-weight:800;
      margin-bottom:10px;
    }
    .card h1 span{ color:#ff6b00; }
    .card .sub{
      color:#888;
      font-size:14px;
      line-height:1.6;
      margin-bottom:25px;
    }
    .details{
      background:#111;
      border:1px dashed #2a2a2a;
      border-radius:12px;
      padding:18px;
      margin-bottom:25px;
      text-align:left;
    }
    .details p{
      font-size:13px;
      color:#aaa;
      margin:6px 0;
      display:flex;
      justify-content:space-between;
    }
    .details p strong{ color:#fff; }
    .btns{
      display:flex;
      gap:12px;
      justify-content:center;
    }
    .btns a{
      flex:1;
      text-decoration:none;
      padding:12px;
      border-radius:10px;
      font-weight:700;
      font-size:13px;
      letter-spacing:0.5px;
      transition:0.3s;
    }
    .btn-primary{
      background:linear-gradient(90deg,#ff6b00,#ff8a00);
      color:#fff;
    }
    .btn-secondary{
      background:#222;
      border:1px solid #2a2a2a;
      color:#ccc;
    }
    .btns a:hover{ transform:translateY(-2px); }
  </style>
</head>
<body>
  <div class="card">
    <div class="check">✓</div>
    <h1>Table <span>Booked!</span></h1>
    <p class="sub">Your reservation has been confirmed. We are waiting for you at ZAiKA, Jhalawar.</p>
    
    <div class="details">
      <p>Restaurant: <strong>ZAiKA - Jhalawar</strong></p>
      <p>Address: <strong>Jhalawar, Rajasthan 326001</strong></p>
      <p>Timing: <strong>10:00 AM - 12:00 AM</strong></p>
      <p>Status: <strong style="color:#22c55e">Confirmed ✓</strong></p>
    </div>

    <div class="btns">
      <a href="/" class="btn-primary">BACK TO HOME</a>
      <a href="/#reservation" class="btn-secondary">NEW BOOKING</a>
    </div>
  </div>
</body>
</html>